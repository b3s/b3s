---
global:
  resolve_timeout: 5m
  smtp_smarthost: smtp.postmarkapp.com:587
  smtp_from: "b3s monitoring <b3s@b3s.me>"
  smtp_auth_username: "${POSTMARK_API_TOKEN}"
  smtp_auth_password: "${POSTMARK_API_TOKEN}"
  smtp_require_tls: true

route:
  receiver: email
  group_by:
    - alertname
    - instance
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    - matchers:
        - severity="critical"
      receiver: email
      repeat_interval: 4h

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal:
      - component
      - instance

receivers:
  - name: email
    email_configs:
      - to: inge@elektronaut.no
        send_resolved: true
        headers:
          Subject: >-
            [b3s] {{ .Status | toUpper }}{{ if eq .Status "firing" }}
            ({{ len .Alerts.Firing }}){{ end }} {{ .CommonLabels.alertname }}
